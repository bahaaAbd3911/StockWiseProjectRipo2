# Caddy is the front door of the whole platform: one server, every store.
#
#   ahmad.myplatform.com, omar.myplatform.com   stores (subdomains)
#   shop.example.com                           a store's verified custom domain
#   admin.myplatform.com                       the platform super admin
#
# For every host it serves the same React app (built into /srv), and sends
# /api and /uploads to the Go API, which finds the store from the host name.
#
# HTTPS certificates are obtained on demand, at the first visit of a host -
# but only after the API confirms the host is really served
# (/internal/tls-check: a store subdomain, a verified custom domain of an
# active store, the platform admin or the bare platform domain). Random
# names pointed at the server never get a certificate.
#
# Note: Let's Encrypt issues at most 50 certificates per week per registered
# domain. With many store subdomains, switch them to one wildcard certificate
# (*.myplatform.com) - see docs/production.md, "Many stores".

{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://api:8080/internal/tls-check
	}
}

# Plain HTTP: redirect everything to HTTPS (308 keeps POST as POST).
http:// {
	redir https://{host}{uri} 308
}

https:// {
	tls {
		on_demand
	}
	encode zstd gzip

	# The certificate check is only for Caddy itself.
	handle /internal/* {
		respond 404
	}

	handle /api/* {
		reverse_proxy api:8080 {
			# The API reads the store from Host and the visitor's IP from X-Forwarded-For.
			header_up Host {host}
		}
	}

	handle /uploads/* {
		request_body {
			max_size 12MB
		}
		reverse_proxy api:8080
	}

	# Everything else is the React app; unknown paths load index.html so the
	# app's own routes (/client/home, /admin, ...) work on reload.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
