# Caddy terminates HTTPS for the API. It gets and renews Let's Encrypt
# certificates on its own once API_DOMAIN points at this server (DNS A/AAAA
# record) and ports 80/443 are open.
#
# Caddy sets X-Forwarded-For and X-Forwarded-Proto, so run the API with
# TRUST_PROXY=true behind it.

{$API_DOMAIN} {
	encode zstd gzip

	# Uploaded images can be larger than JSON bodies; the API enforces its own limit.
	request_body {
		max_size 12MB
	}

	reverse_proxy api:8080 {
		health_uri /api/health
	}

	log {
		output stdout
		format json
	}
}
