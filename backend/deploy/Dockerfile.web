# The web server image: the React app built into static files, served by
# Caddy together with the Caddyfile (HTTPS, /api and /uploads to the API).
#
# Built by docker-compose.yml from the repository root:
#   docker build -f backend/deploy/Dockerfile.web -t stockwise-web .

# ---- build the React app ----
FROM node:22-alpine AS build
WORKDIR /app
COPY Front-End/package.json Front-End/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY Front-End/ ./
# The app calls /api on its own address, so no API URL is baked in: one
# build serves every store and every custom domain.
RUN npm run build

# ---- serve ----
FROM caddy:2-alpine
COPY backend/deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
