# Copy this file to .env and fill in your own values. Never commit .env.

# Port the API listens on.
APP_PORT=8080

# PostgreSQL connection string.
DATABASE_URL=postgres://USERNAME:PASSWORD@localhost:5432/ecommerce?sslmode=disable

# Secret used to sign login tokens. REQUIRED, at least 32 characters.
# Generate one with:  openssl rand -base64 32
JWT_SECRET=replace_with_at_least_32_random_characters

# How long a login token stays valid (Go duration: 24h, 90m, ...). Optional.
JWT_TTL=24h

# Browser origins allowed to call the API (comma separated). Optional.
# Default is the Vite dev server.
CORS_ALLOWED_ORIGINS=http://localhost:5173
