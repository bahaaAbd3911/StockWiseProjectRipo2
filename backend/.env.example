# Development settings. Copy this file to .env and fill in your own values.
# Never commit .env. For a server, start from .env.production.example instead.
# Every setting is explained in docs/GUIDE.md (section "Configuration").

# development (default) or production. Production refuses to start with unsafe
# settings (placeholder secret, localhost addresses, emails printed to the log...).
APP_ENV=development

# Port the API listens on (plain HTTP).
APP_PORT=8080

# PostgreSQL connection string.
# Local: postgres://USERNAME:PASSWORD@localhost:5432/ecommerce?sslmode=disable
# Neon (cloud): paste the connection string from the Neon dashboard and keep
#   sslmode=require, e.g.
#   postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
#   Then create the tables in it once:  go run ./cmd/migrate up
DATABASE_URL=postgres://USERNAME:PASSWORD@localhost:5432/ecommerce?sslmode=disable
# Maximum open database connections (keep below the server's limit).
DB_MAX_CONNS=25

# Secret used to sign login tokens. REQUIRED, at least 32 characters.
# Generate one (PowerShell):
#   [Convert]::ToBase64String((1..48 | % { [byte](Get-Random -Max 256) }))
# or:  openssl rand -base64 48
JWT_SECRET=replace_with_at_least_32_random_characters

# How long a login token stays valid (Go duration: 24h, 90m, ...).
JWT_TTL=24h

# Browser origins allowed to call the API (comma separated).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- The shop (used in emails) ----

STORE_NAME=StockWise
# The frontend's address; emailed links point here.
FRONTEND_URL=http://localhost:5173
# Printed after amounts in emails (e.g. JOD). Empty = no currency.
CURRENCY=
# Admin dashboard: when a day starts, and the stock level that counts as "low".
STORE_TIMEZONE=Asia/Amman
LOW_STOCK_THRESHOLD=5

# ---- Stores (multi-tenant) ----
# Stores are reached at <slug>.PLATFORM_DOMAIN (e.g. ahmad.myplatform.com).
# DEFAULT_STORE is the store for any other host name (localhost, an IP...).
# One shop: leave PLATFORM_DOMAIN empty and DEFAULT_STORE=main.
# A platform: set PLATFORM_DOMAIN and leave DEFAULT_STORE empty so unknown hosts get 404.
PLATFORM_DOMAIN=
DEFAULT_STORE=main

# ---- Security ----

# Rate limiting (per IP and per email). Keep true in production.
RATE_LIMIT_ENABLED=true

# Set true ONLY when the API runs behind a reverse proxy / load balancer that
# sets X-Forwarded-For (Nginx, Caddy, Render, Railway, ...). Otherwise clients
# could fake their IP and bypass the rate limits.
TRUST_PROXY=false

# ---- HTTPS (leave off when a proxy or platform handles it) ----

# off | auto (Let's Encrypt for TLS_DOMAINS) | files (your own certificate)
TLS_MODE=off
TLS_DOMAINS=
TLS_EMAIL=
TLS_CACHE_DIR=data/certs
TLS_CERT_FILE=
TLS_KEY_FILE=
TLS_PORT=443
TLS_HTTP_PORT=80

# ---- Emails ----

# log  = print emails to the server console (development; nothing is sent:
#        copy confirmation / reset links from the terminal)
# smtp = send through an SMTP provider (production)
MAIL_DRIVER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# e.g. StockWise <no-reply@your-domain.com>
SMTP_FROM=

# Password reset: frontend page (default FRONTEND_URL/reset-password) and link lifetime (1m - 24h).
PASSWORD_RESET_URL=
PASSWORD_RESET_TTL=30m

# Email confirmation at sign-up: frontend page (default FRONTEND_URL/verify-email),
# link lifetime (1h - 168h), and whether checkout needs a confirmed email.
EMAIL_VERIFY_URL=
EMAIL_VERIFY_TTL=48h
REQUIRE_EMAIL_VERIFICATION=true

# Notification queue: how often it is checked, and how often customers with an
# open balance get a reminder (0 = never).
EMAIL_POLL_INTERVAL=5s
DEBT_REMINDER_INTERVAL=168h

# ---- Image uploads ----

# The API's own public address; uploaded images are served from PUBLIC_URL/uploads/...
# Default http://localhost:APP_PORT
PUBLIC_URL=
# local = files in UPLOAD_DIR (needs a disk that survives deploys)
# s3    = any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, MinIO)
STORAGE_DRIVER=local
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=5
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Where the bucket's files can be read publicly (CDN / r2.dev / bucket URL)
S3_PUBLIC_URL=
S3_INSECURE=false
