# Copy this file to .env and fill in your own values. Never commit .env.

# Port the API listens on.
APP_PORT=8080

# PostgreSQL connection string.
DATABASE_URL=postgres://USERNAME:PASSWORD@localhost:5432/ecommerce?sslmode=disable

# Secret used to sign login tokens. REQUIRED, at least 32 characters.
# Generate one with:  openssl rand -base64 32
JWT_SECRET=replace_with_at_least_32_random_characters

# How long a login token stays valid (Go duration: 24h, 90m, ...). Optional.
JWT_TTL=24h

# Browser origins allowed to call the API (comma separated). Optional.
# Default is the Vite dev server.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Security ----

# Rate limiting (per IP and per email). Keep true in production.
RATE_LIMIT_ENABLED=true

# Set true ONLY when the API runs behind a reverse proxy / load balancer that
# sets X-Forwarded-For (Nginx, Caddy, Render, Railway, ...). Otherwise clients
# could fake their IP and bypass the rate limits.
TRUST_PROXY=false

# ---- Password reset emails ----

# Frontend page that opens the reset link (?token=... is appended).
PASSWORD_RESET_URL=http://localhost:5173/reset-password
# How long a reset link works (1m - 24h).
PASSWORD_RESET_TTL=30m

# log  = print emails to the server console (development; no email is sent)
# smtp = send through an SMTP provider (production)
MAIL_DRIVER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# e.g. StockWise <no-reply@your-domain.com>
SMTP_FROM=
