# Production settings. Copy to .env.production on the server, fill in every
# <...> value, and never commit the copy.
#
#   cp .env.production.example .env.production
#   docker compose --env-file .env.production up -d --build
#
# With APP_ENV=production the API refuses to start while anything here is
# unsafe and prints the full list of what to fix.

APP_ENV=production

# ---- Addresses ----
# The platform's domain. Stores live at <slug>.PLATFORM_DOMAIN, the platform
# super admin at admin.PLATFORM_DOMAIN, custom domains are added per store.
# DNS: A (and AAAA) records for PLATFORM_DOMAIN and *.PLATFORM_DOMAIN -> this server.
PLATFORM_DOMAIN=<myplatform.com>
# The store shown on the bare domain (and the address in its emails); empty = 404 there.
DEFAULT_STORE=main
FRONTEND_URL=https://<myplatform.com>
# Uploaded images are served at PUBLIC_URL/uploads/<store id>/... (any store host works).
PUBLIC_URL=https://<myplatform.com>
# The app calls /api on its own host; this only matters for other origins.
CORS_ALLOWED_ORIGINS=https://<myplatform.com>
# Required: where Let's Encrypt sends certificate warnings.
ACME_EMAIL=<you@your-domain.com>
# Optional overrides: PLATFORM_ADMIN_HOST (default admin.PLATFORM_DOMAIN, "off" = none),
# STORE_URL (a store's address in emails, default https://{slug}.PLATFORM_DOMAIN).
PLATFORM_ADMIN_HOST=
STORE_URL=

# ---- Database (the db service in docker-compose.yml) ----
# Use a long random password with letters and digits only (it goes into a URL).
POSTGRES_USER=shop_api
POSTGRES_PASSWORD=<long-random-letters-and-digits>
POSTGRES_DB=ecommerce
# Managed database instead? Set the full URL (with sslmode=require) and remove
# the db service from docker-compose.yml:
# DATABASE_URL=postgres://user:password@host:5432/ecommerce?sslmode=require
DB_MAX_CONNS=20

# ---- Login tokens ----
# 48 random bytes, e.g.  openssl rand -base64 48
JWT_SECRET=<random-secret>
JWT_TTL=24h

# ---- Shop ----
STORE_NAME=StockWise
CURRENCY=JOD
STORE_TIMEZONE=Asia/Amman
LOW_STOCK_THRESHOLD=5

# ---- Emails (required in production) ----
MAIL_DRIVER=smtp
SMTP_HOST=<smtp.your-provider.com>
SMTP_PORT=587
SMTP_USERNAME=<username>
SMTP_PASSWORD=<password>
SMTP_FROM=StockWise <no-reply@your-domain.com>
REQUIRE_EMAIL_VERIFICATION=true
DEBT_REMINDER_INTERVAL=168h

# ---- Uploads ----
# local keeps files in the "uploads" Docker volume. For S3/R2 set
# STORAGE_DRIVER=s3 and the S3_* values (see .env.example).
STORAGE_DRIVER=local
MAX_UPLOAD_MB=5

# ---- Set by docker-compose.yml for the api service (Caddy does HTTPS) ----
# TLS_MODE=off
# TRUST_PROXY=true
RATE_LIMIT_ENABLED=true
